{
  "name": "float-play",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern Chrome extension that enhances YouTube Picture-in-Picture with better playback controls.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.options.config.mjs && vite build --config vite.service-worker.config.mjs",
    "build:options": "vite build --config vite.options.config.mjs",
    "build:service-worker": "vite build --config vite.service-worker.config.mjs",
    "dev": "vite build --watch",
    "dev:options": "vite build --config vite.options.config.mjs --watch",
    "dev:service-worker": "vite build --config vite.service-worker.config.mjs --watch",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
