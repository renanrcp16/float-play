{
  "name": "float-play",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern Chrome extension that enhances YouTube Picture-in-Picture with better playback controls.",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.7.0",
    "eslint": "^10.7.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  }
}
