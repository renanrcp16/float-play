{
  "name": "float-play",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern Chrome extension that enhances YouTube Picture-in-Picture with better playback controls.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "audit:dependencies": "pnpm audit --audit-level=high && pnpm --dir e2e audit --audit-level=high",
    "build": "vite build && vite build --config vite.options.config.mjs && vite build --config vite.service-worker.config.mjs && vite build --config vite.youtube-player.config.mjs",
    "build:options": "vite build --config vite.options.config.mjs",
    "build:service-worker": "vite build --config vite.service-worker.config.mjs",
    "build:youtube-player": "vite build --config vite.youtube-player.config.mjs",
    "capture:store-screenshot": "pnpm build && pnpm --dir e2e capture:store-screenshot",
    "dev": "vite build --watch",
    "dev:options": "vite build --config vite.options.config.mjs --watch",
    "dev:service-worker": "vite build --config vite.service-worker.config.mjs --watch",
    "dev:youtube-player": "vite build --config vite.youtube-player.config.mjs --watch",
    "e2e:install": "pnpm --dir e2e install --frozen-lockfile && pnpm --dir e2e exec playwright install chromium",
    "lint": "eslint .",
    "package:release": "pnpm verify:release && node scripts/package-release.mjs",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && pnpm --dir e2e test",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:release": "pnpm build && node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
